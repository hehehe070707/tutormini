.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F7F9FA;
}

.chat-list {
  flex: 1;
  padding: 12px;
  box-sizing: border-box;
}

.chat-card {
  display: flex;
  align-items: center;
  padding: 10px 12px;
  margin: 8px 8px 0;
  background: #FFFFFF;
  border: 1px solid #ECEFF3;
  border-radius: 10px;
  box-shadow: 0 1px 2px rgba(17, 24, 39, 0.03);
}

.cc-role {
  display: inline-block;
  font-size: 11px;
  color: #0A9C90;
  background: #F3FBFA;
  border: 1px solid #CFF0EA;
  border-radius: 6px;
  padding: 0 6px;
  margin-bottom: 4px;
}

.cc-subject { font-size: 14px; font-weight: bold; color: #0A9C90; }

.chat-tip { text-align: center; margin-bottom: 12px; }

.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 8px 12px;
  background: #ffffff;
  border-top: 1px solid #ECEFF3;
}

.send-btn {
  margin-left: 8px;
  font-size: 14px;
  line-height: 2.3;
  padding: 0 16px;
}
