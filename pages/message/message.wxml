<view class="page">
  <view class="page-title">消息</view>
  <view class="gap"></view>

  <view class="card guest-tip" wx:if="{{guest}}">
    <view class="muted">登录后这里显示官方助手和系统通知。</view>
    <view class="gap"></view>
    <button class="btn" bindtap="onLogin">登录 / 注册</button>
  </view>

  <block wx:else>

  <block wx:if="{{agents.length > 0}}">
    <view class="page-title section">官方助手</view>
    <view class="list">
      <view class="list-row agent-row" wx:for="{{agents}}" wx:key="id">
        <view class="avatar agent-avatar">🤖</view>
        <view class="grow">
          <view class="m-name {{item.unread > 0 ? 'dot' : ''}}">{{item.displayName}}
            <text class="official-tag">官方</text></view>
          <view class="muted">{{item.lastBody}}</view>
        </view>
        <view class="m-right">
          <view class="muted">{{item.lastAt}}</view>
          <button class="btn btn-sm m-open" data-id="{{item.id}}" data-name="{{item.name}}"
                  bindtap="onOpenAgent">打开</button>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{boxes.length > 0 || hiddenCount > 0}}">
    <view class="section-head">
      <view class="page-title">我的单子</view>
      <view class="hide-toggle" wx:if="{{hiddenCount > 0}}" bindtap="onToggleHidden">
        {{showHidden ? '收起已隐藏' : '已隐藏 ' + hiddenCount + ' 条'}}
      </view>
    </view>

    <view class="card box-card" wx:for="{{boxes}}" wx:key="id">
      <view class="box-head">
        <view class="grow">
          <view class="box-code">{{item.code}}
            <text class="box-subject">{{item.subjectText}}</text>
          </view>
          <view class="muted">发布 {{item.createdAt}} · {{item.publisherName}}</view>
        </view>
        <view class="box-state">
          <text class="{{item.statusClass}}">{{item.statusText}}</text>
          <text class="badge" wx:if="{{item.unread > 0}}">{{item.unreadText}}</text>
          <text class="hid-tag" wx:if="{{item.hidden}}">已隐藏</text>
        </view>
      </view>

      <view class="box-attrs">
        <view class="muted">上课时间：{{item.timeText}}</view>
        <view class="muted">价格：{{item.price}}</view>
        <view class="muted">位置：{{item.area}}</view>
        <view class="muted">说明：{{item.note}}</view>
        <view class="muted">对老师的要求：{{item.requirementText}}</view>
        <view class="muted">家长原话：{{item.rawText}}</view>
        <view class="muted" wx:if="{{item.inviteText}}">{{item.inviteText}}</view>
      </view>

      <view class="box-msgs">
        <view class="box-msg {{msg.isRead ? '' : 'unread'}}" wx:for="{{item.rows}}" wx:for-item="msg" wx:key="id"
              data-url="{{msg.contractUrl}}" bindtap="onTapMessage">
          <view class="bm-head">
            <text class="bm-title">{{msg.title}}</text>
            <text class="notice-tag">{{msg.tagText}}</text>
            <text class="bm-time">{{msg.createdAt}}</text>
          </view>
          <view class="muted bm-body">{{msg.body}}</view>
          <view class="muted bm-tip" wx:if="{{msg.contractUrl}}">有合同链接，点一下复制</view>
        </view>
      </view>

      <view class="box-foot">
        <view class="muted">共 {{item.count}} 条</view>
        <view class="box-hide" wx:if="{{item.canHide && !item.hidden}}"
              data-post-id="{{item.id}}" data-last-id="{{item.lastId}}" bindtap="onHideBox">隐藏</view>
      </view>
    </view>
  </block>

  <block wx:if="{{notices.length > 0}}">
    <view class="page-title section">通知</view>
    <view class="list">
      <view class="list-row" wx:for="{{notices}}" wx:key="id"
            data-index="{{index}}" bindtap="onOpenNotice">
        <view class="grow">
          <view class="m-name">{{item.title}} <text class="notice-tag">{{item.tagText}}</text>
            <text class="muted" wx:if="{{!item.isRead}}">·未读</text></view>
          <view class="muted">{{item.body}}</view>
          <view class="muted" wx:if="{{item.contractUrl}}">有合同链接，点开可复制</view>
        </view>
        <view class="m-right"><view class="muted">{{item.createdAt}}</view></view>
      </view>
    </view>
  </block>

  <view class="empty" wx:if="{{empty}}">{{empty}}</view>
  </block>

</view>
