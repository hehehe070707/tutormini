/* 单子管理：这条单的全部属性 + 投递 + 合同收款 + 修正 */

.section { margin: 14px 0 8px; }
.guest-tip { background: #F3FBFA; border-color: #CFF0EA; }

.pm-head { background: #F3FBFA; border-color: #CFF0EA; }
.pm-title { display: flex; align-items: center; flex-wrap: wrap; color: #1F2328; }
.pm-code { font-size: 16px; font-weight: bold; }
.pm-subject { font-size: 13px; font-weight: normal; margin-left: 6px; }
.pm-status { font-size: 13px; margin-left: 6px; }
.pm-title .red-dot { margin-left: 6px; }
.page-title .red-dot { margin-left: 8px; }
.pm-hint { margin: 2px 2px 8px; line-height: 1.6; }
.pm-attrs { margin-top: 8px; padding-top: 6px; border-top: 1px dashed #ECEFF3; }
.pm-attrs .muted { line-height: 1.7; word-break: break-all; }

/* 操作按钮：一行放不下就换行，别挤成一条 */
.pm-ops {
  display: flex; flex-wrap: wrap; justify-content: flex-end;
  margin-top: 8px;
}
.pm-ops .btn, .pm-ops .btn-ghost, .pm-ops .btn-danger { margin: 6px 0 0 6px; }
.pm-invite { align-items: center; }
.pm-booking { align-items: flex-start; }
.pm-invite-name { font-size: 15px; font-weight: bold; color: #0A9C90; margin-bottom: 2px; }

.fix-card { background: #FFFFFF; }
.fix-label { font-size: 13px; color: #6B7280; margin: 10px 0 6px; }
.fix-row { display: flex; align-items: center; margin-bottom: 8px; }
.fix-row .picker-value { flex: 1; }
.fix-save { margin-left: 8px; }
.fix-notify { margin-top: 12px; }
.fix-log { font-size: 12px; margin-top: 4px; word-break: break-all; }
.fix-void { margin-top: 12px; }
