.p-name { font-size: 15px; font-weight: bold; margin-bottom: 2px; }
.p-ops { display: flex; flex-direction: column; align-items: flex-end; }
.p-take { margin-top: 6px; }
.section { margin: 14px 0 8px; }

.nearby-bar { background: #FFFFFF; border-color: #CFF0EA; }

.note-clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.more-tip { color: #0A9C90; font-size: 12px; margin-top: 2px; }

.clash-tip { color: #E08700; font-size: 12px; }

.filter-card { background: #FFFFFF; border-color: #CFF0EA; }
.filter-title { font-size: 15px; font-weight: bold; margin-bottom: 2px; }
.filter-body { margin-top: 10px; }
.filter-body .field { margin-bottom: 8px; }

.pick-item { display: inline-block; margin: 0 16px 6px 0; font-size: 13px; }
.filter-body .section { margin: 10px 0 4px; font-size: 14px; }

.match-line { margin: 2px 0 4px; }
.match-badge {
  font-size: 12px; padding: 1px 8px; border-radius: 8rpx; margin-right: 6px;
}
.match-badge.st-confirmed { background: #E7F8F5; color: #0A9C90; }
.match-badge.st-pending { background: #FFF4E0; color: #E08700; }
.match-badge.st-rejected { background: #FFEFF0; color: #E5484D; }
.match-tip { font-size: 12px; }

.parse-tip { font-size: 12px; margin-left: 10px; }

.d-row { display: flex; margin-bottom: 8px; }
.d-label { width: 68px; color: #6B7280; font-size: 13px; flex-shrink: 0; }
.d-value { flex: 1; font-size: 14px; word-break: break-all; }

.post-row { align-items: flex-start; }
.invite-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6px;
  padding-top: 6px;
  border-top: 1px dashed #F2F4F7;
}
.post-row .p-ops { flex-direction: row; flex-wrap: wrap; justify-content: flex-end; }
.post-row .p-ops .btn, .post-row .p-ops .btn-ghost, .post-row .p-ops .btn-danger { margin-left: 6px; }
.post-row .p-take { margin-top: 0; }

.lesson-box { margin-top: 8px; }
.lesson-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 6px 0;
  border-top: 1px dashed #F2F4F7;
}
.lesson-title { font-size: 14px; }
.lesson-row .p-ops { flex-direction: row; justify-content: flex-end; }

.wb-title { font-size: 15px; font-weight: bold; color: #1F2328; margin-bottom: 4px; }
.pub-tip { background: #F3FBFA; border-color: #CFF0EA; }
.pub-tip .muted { line-height: 1.7; }
.pub-big { margin-top: 12px; }
