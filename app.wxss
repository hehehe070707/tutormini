page {
  background-color: #FFFFFF;

  background-image: radial-gradient(100% 100% at 0% 0%,
      #E7F8F5 0%,
      rgba(30, 174, 148, 0.56) 45%,
      rgba(231, 248, 245, 0) 100%);
  background-repeat: no-repeat;
  background-position: left top;
  background-size: 50vw 25vh;
  color: #1F2328;
  font-size: 14px;
  line-height: 1.5;
}

.grad {
  background-image: linear-gradient(135deg, #38E1C6 0%, #0FB5A6 100%);
}

.grad-text {
  background-image: linear-gradient(135deg, #2FD3BE 0%, #0FB5A6 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: #0FB5A6;
  -webkit-text-fill-color: transparent;
}

.btn {
  background-color: #0FB5A6;
  background-image: linear-gradient(135deg, #38E1C6 0%, #0FB5A6 100%);
  color: #FFFFFF;
  border-radius: 10px;
  font-weight: bold;
  font-size: 15px;
  line-height: 2.5;
  letter-spacing: 0.5px;
  text-align: center;
  padding: 0 18px;
  border: 0;
  box-shadow: 0 4px 12px rgba(15, 181, 166, 0.22);
}

.btn:active { background-image: linear-gradient(135deg, #2FD3BE 0%, #0A9C90 100%); }

.btn[disabled], .btn.disabled {
  background-color: #C9CFD6;
  background-image: none;
  color: #FFFFFF;
  box-shadow: none;
}

.btn-ghost {
  background-color: #FFFFFF;
  color: #0FB5A6;
  border: 1px solid #CFF0EA;
  border-radius: 10px;
  font-weight: bold;
  font-size: 14px;
  line-height: 2.3;
  text-align: center;
  padding: 0 14px;
}

.btn-ghost:active { background-color: #E7F8F5; border-color: #0FB5A6; }

.btn-danger {
  background-color: #FFFFFF;
  color: #E5484D;
  border: 1px solid #FFD7D9;
  border-radius: 10px;
  font-weight: bold;
  font-size: 14px;
  line-height: 2.3;
  text-align: center;
  padding: 0 14px;
}

.btn-danger:active { background-color: #FFEFF0; }

.btn-sm {
  font-size: 13px;
  line-height: 2.1;
  padding: 0 12px;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
}
button::after { border: none; }

.card {
  background-color: #FFFFFF;
  border: 1px solid #ECEFF3;
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 10px;
  box-shadow: 0 2px 10px rgba(17, 24, 39, 0.04);
}

.page {
  min-height: 100vh;
  padding: 12px;
  box-sizing: border-box;
  padding-bottom: 84px;
}

.page-plain {
  min-height: 100vh;
  padding: 12px;
  box-sizing: border-box;
}

.page-title {
  font-size: 16px;
  font-weight: bold;
  color: #1F2328;
  letter-spacing: 0.5px;
  padding-left: 10px;
  position: relative;
}

.page-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  margin-top: -8px;
  width: 4px;
  height: 16px;
  border-radius: 2px;
  background-image: linear-gradient(180deg, #38E1C6 0%, #0FB5A6 100%);
}

.muted {
  color: #6B7280;
  font-size: 13px;
}

.group-divider {
  display: flex;
  align-items: center;
  margin: 14px 2px 8px;
  color: #9CA3AF;
  font-size: 12px;
}

.group-divider::before,
.group-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background-color: #ECEFF3;
}

.group-divider .group-divider-text {
  padding: 0 10px;
  white-space: nowrap;
}

.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.grow { flex: 1; }
.gap { height: 8px; }

.field {
  display: flex;
  align-items: center;
  margin-bottom: 10px;
}

.field-label {
  width: 68px;
  color: #6B7280;
  font-size: 13px;
  flex-shrink: 0;
}

.input {
  flex: 1;
  height: 42px;
  line-height: 40px;
  border: 1px solid #ECEFF3;
  border-radius: 10px;
  padding: 0 12px;
  background-color: #F7F9FA;
  color: #1F2328;
  font-size: 14px;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 60px;
  border: 1px solid #ECEFF3;
  border-radius: 10px;
  padding: 10px;
  background-color: #F7F9FA;
  color: #1F2328;
  font-size: 14px;
  box-sizing: border-box;
}

.loc-btn {
  flex-shrink: 0;
  margin-left: 6px;
  height: 42px;
  line-height: 40px;
  padding: 0 10px;
  border: 1px solid #CFF0EA;
  border-radius: 10px;
  background-color: #E7F8F5;
  color: #0A9C90;
  font-size: 13px;
  font-weight: bold;
  white-space: nowrap;
}

.loc-btn:active { background-color: #D9F2ED; }

.picker-value {
  flex: 1;
  height: 42px;
  line-height: 40px;
  border: 1px solid #ECEFF3;
  border-radius: 10px;
  padding: 0 12px;
  background-color: #F7F9FA;
  color: #1F2328;
  font-size: 14px;
  box-sizing: border-box;
}

.list {
  background-color: #FFFFFF;
  border: 1px solid #ECEFF3;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 10px rgba(17, 24, 39, 0.04);
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 14px;
  border-bottom: 1px solid #F2F4F7;
}

.list-row:last-child { border-bottom: 0; }

.empty {
  color: #9CA3AF;
  text-align: center;
  padding: 28px 12px;
  font-size: 13px;
  line-height: 1.7;
}

.st-pending { color: #E08700; }
.st-confirmed { color: #0A9C90; }
.st-rejected { color: #E5484D; }
.st-cancelled { color: #9CA3AF; text-decoration: line-through; }
.st-open { color: #E08700; }
.st-taken { color: #0A9C90; }
.st-closed { color: #9CA3AF; }

.badge {
  background-color: #E5484D;
  color: #FFFFFF;
  border-radius: 9px;
  font-size: 11px;
  font-weight: bold;
  padding: 0 5px;
  line-height: 18px;
  min-width: 18px;
  text-align: center;
}

.dot { color: #E5484D; }

.red-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #E5484D;
  margin: 0 5px 0 0;
  vertical-align: middle;
}

.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(17, 24, 39, 0.35);
  z-index: 100;
}

.dialog {
  position: fixed;
  left: 24px;
  right: 24px;
  top: 50%;
  transform: translateY(-50%);
  background: #FFFFFF;
  border-radius: 16px;
  padding: 18px;
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: 0 8px 30px rgba(17, 24, 39, 0.14);
}

.dialog-title {
  font-size: 16px;
  font-weight: bold;
  color: #1F2328;
  margin-bottom: 14px;
  text-align: center;
  letter-spacing: 0.5px;
}

.dialog-buttons {
  display: flex;
  margin-top: 14px;
}

.dialog-buttons .btn,
.dialog-buttons .btn-ghost,
.dialog-buttons .btn-danger {
  flex: 1;
}

.dialog-buttons .btn + .btn,
.dialog-buttons .btn + .btn-ghost,
.dialog-buttons .btn-ghost + .btn,
.dialog-buttons .btn-ghost + .btn-ghost,
.dialog-buttons .btn + .btn-danger,
.dialog-buttons .btn-ghost + .btn-danger {
  margin-left: 10px;
}

.login-title {
  font-size: 26px;
  font-weight: bold;
  color: #0FB5A6;
  letter-spacing: 3px;
  text-align: center;
  background-image: linear-gradient(135deg, #2FD3BE 0%, #0FB5A6 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.login-sub {
  color: #9CA3AF;
  text-align: center;
  font-size: 13px;
  line-height: 1.7;
}

.card-title {
  font-size: 15px;
  font-weight: bold;
  color: #0A9C90;
  letter-spacing: 0.5px;
}

.avatar {
  width: 76px;
  height: 76px;
  line-height: 76px;
  border-radius: 38px;
  background-color: #F7F9FA;
  border: 1px solid #CFF0EA;
  text-align: center;
  font-size: 38px;
  box-sizing: border-box;
}

.bubble-wrap { display: flex; margin-bottom: 10px; }
.bubble-wrap.mine { justify-content: flex-end; }
.bubble-wrap.peer { justify-content: flex-start; }

.bubble {
  max-width: 74%;
  padding: 10px 12px;
  border-radius: 12px;
  background: #FFFFFF;
  border: 1px solid #ECEFF3;
  font-size: 14px;
  color: #1F2328;
  word-break: break-all;
}

.bubble-wrap.mine .bubble {
  background: #E7F8F5;
  border-color: #CFF0EA;
  color: #0A9C90;
}

.bubble-time {
  font-size: 11px;
  color: #9CA3AF;
  margin-top: 4px;
}
