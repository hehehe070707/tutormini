.nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60px;
  display: flex;
  background-color: #ffffff;
  border-top: 1px solid #ECEFF3;
  box-shadow: 0 -1px 6px rgba(17, 24, 39, 0.04);
  z-index: 90;
}

.nav-item {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
  font-size: 12px;
}

.nav-label {
  text-align: center;
  line-height: 17px;
  white-space: pre-line;
}

.nav-active { color: #0A9C90; font-weight: bold; }

.nav-active::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  margin-left: -14px;
  width: 28px;
  height: 2px;
  background-image: linear-gradient(90deg, #38E1C6 0%, #0FB5A6 100%);
  border-radius: 0 0 2px 2px;
}

.nav-badge {
  position: absolute;
  right: 18%;
  top: 6px;
}

.badge {
  background-color: #E5484D;
  color: #FFFFFF;
  border-radius: 9px;
  font-size: 11px;
  font-weight: bold;
  padding: 0 5px;
  line-height: 18px;
  min-width: 18px;
  text-align: center;
}
